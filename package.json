{
  "name": "x-bookmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "app": "pnpm --filter @x-bookmarks/web run app",
    "pair": "pnpm --silent --filter @x-bookmarks/web run pair",
    "extension:build": "pnpm --filter @x-bookmarks/extension run build",
    "reparse": "pnpm --silent --filter @x-bookmarks/web run reparse",
    "backup": "pnpm --silent --filter @x-bookmarks/web run backup",
    "tag": "pnpm --silent --filter @x-bookmarks/tagger run tag",
    "digest": "pnpm --silent --filter @x-bookmarks/tagger run digest",
    "demo": "pnpm --silent --filter @x-bookmarks/demo run demo",
    "screenshots": "pnpm --silent --filter @x-bookmarks/demo run screenshots",
    "diagram": "pnpm --silent --filter @x-bookmarks/demo run diagram",
    "fixtures:build": "pnpm --silent --filter @x-bookmarks/core run fixtures:build",
    "fixtures:check": "pnpm --silent --filter @x-bookmarks/core run fixtures:check",
    "typecheck": "tsc --noEmit && pnpm --recursive run typecheck",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "test": "vitest run",
    "e2e": "pnpm --filter @x-bookmarks/e2e run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  }
}
