# Dependencies
node_modules/

# Build and tool output
dist/
build/
out/
.next/
.next-e2e/
.next-demo/
next-env.d.ts
coverage/
*.tsbuildinfo

# Local data. Captured bookmark data is personal: it never goes into git.
# /data/ holds the database and any unredacted responses saved while debugging.
/data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# The demo library `pnpm demo` builds: invented posts, made again each run.
/demo-data/

*.capture.json
*.har

# Secrets and local environment
.env
.env.*
!.env.example

# Other checkouts of this repo that tools place inside it (git worktrees).
# Each is checked by its own run of the tools, from its own root.
/.claude/worktrees/

# Claude Code's settings for one computer: its paths, and what it may run
# here. Settings a team shares, .claude/settings.json, are the repo's.
/.claude/settings.local.json

# OS and editor
.DS_Store
*.log
