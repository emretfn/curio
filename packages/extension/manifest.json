{
  "manifest_version": 3,
  "name": "x-bookmarks capture",
  "version": "0.1.0",
  "description": "Keeps a copy of the bookmark responses X's web client receives while you browse, and hands them to the x-bookmarks app on this computer. Sends nothing to X.",
  "key": "",
  "minimum_chrome_version": "130",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47130/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "x-bookmarks capture",
    "default_popup": "popup.html"
  }
}
