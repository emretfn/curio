{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!docs/research", "!**/fixtures"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "better-sqlite3",
                  "better-sqlite3/**",
                  "node:sqlite",
                  "bun:sqlite",
                  "sqlite",
                  "sqlite3",
                  "libsql",
                  "@libsql/**",
                  "sql.js",
                  "@sqlite.org/**"
                ],
                "message": "Only packages/core may open the database. Use the functions exported by @x-bookmarks/core, and add one there if the one you need is missing."
              },
              {
                "group": [
                  "@x-bookmarks/core/**",
                  "!@x-bookmarks/core/testing",
                  "**/core/src/**"
                ],
                "message": "Import from \"@x-bookmarks/core\", or from \"@x-bookmarks/core/testing\" in a test. Core's internals hold the database connection and are private."
              }
            ],
            "paths": {
              "node:module": {
                "importNames": ["createRequire"],
                "message": "Only packages/core may load a module by name at run time. Use an import statement, and reach the database through @x-bookmarks/core."
              },
              "module": {
                "importNames": ["createRequire"],
                "message": "Only packages/core may load a module by name at run time. Use an import statement, and reach the database through @x-bookmarks/core."
              }
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**", "!packages/core/**"],
      "plugins": ["./lint/sqlite-boundary.grit"]
    }
  ]
}
